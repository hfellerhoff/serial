interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const strokeNodes = STROKE_ICONS[name];
const fillPath = FILL_ICONS[name];

if (!strokeNodes && !fillPath) {
  throw new Error(`Unknown icon: ${name}`);
}
---

{
  strokeNodes ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      {strokeNodes.map(([Tag, attrs]) => <Tag {...attrs} />)}
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      class={className}
      aria-hidden="true"
    >
      <path d={fillPath} />
    </svg>
  )
}
