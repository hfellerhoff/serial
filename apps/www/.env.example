# URL of the Serial app instance signed-in visitors are redirected to.
PUBLIC_APP_URL=""

# Shown in the site footer / pricing page contact links (optional).
PUBLIC_SUPPORT_EMAIL_ADDRESS=""

# Standard.Site publication URI (optional). Enables the
# /.well-known/site.standard.publication endpoint and document <link> tags.
PUBLIC_STANDARD_SITE_PUBLICATION_URI=""

# Umami analytics (optional). Both must be set for the script to be injected.
PUBLIC_UMAMI_WEBSITE_ID=""
PUBLIC_UMAMI_SRC=""

# Only needed for `pnpm standard-site:sync`.
STANDARD_SITE_PDS_URL=""
STANDARD_SITE_IDENTIFIER=""
STANDARD_SITE_APP_PASSWORD=""
